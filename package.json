  "description": "Production-grade Express.js + Prisma + MySQL + JWT Backend for Track It Mobile App",
  "main": "src/server.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
